{
  "name": "@crimson_dev/use-resize-observer",
  "version": "1.0.1",
  "description": "Zero-dependency, Worker-native, ESNext-first React 19 ResizeObserver hook",
  "type": "module",
  "sideEffects": [
    "./dist/shim.js"
  ],
  "license": "MIT",
  "author": {
    "name": "Crimson Dev",
    "url": "https://github.com/ABCrimson"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABCrimson/use-resize-observer.git"
  },
  "homepage": "https://abcrimson.github.io/use-resize-observer/",
  "bugs": {
    "url": "https://github.com/ABCrimson/use-resize-observer/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ABCrimson"
  },
  "keywords": [
    "react",
    "hook",
    "resize",
    "ResizeObserver",
    "typescript",
    "esm",
    "worker",
    "performance"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./shim": {
      "types": "./dist/shim.d.ts",
      "import": "./dist/shim.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=25.0.0"
  },
  "peerDependencies": {
    "react": ">=19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/cli": "3.0.1",
    "@size-limit/preset-small-lib": "13.0.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/browser-playwright": "5.0.0-rc.2",
    "@vitest/coverage-v8": "5.0.0-rc.2",
    "@vitest/ui": "5.0.0-rc.2",
    "babel-plugin-react-compiler": "0.0.0-experimental-a1856f3-20260507",
    "concurrently": "10.0.5",
    "happy-dom": "20.11.10",
    "playwright": "1.63.0-alpha-2026-08-27",
    "publint": "0.3.24",
    "react": "19.3.0-canary-a1124489-20260826",
    "react-dom": "19.3.0-canary-a1124489-20260826",
    "shiki": "4.4.3",
    "simple-git-hooks": "2.13.1",
    "size-limit": "13.0.3",
    "svgo": "4.1.0",
    "tinybench": "6.1.3",
    "tsdown": "0.23.0-rc.0",
    "tsx": "4.23.12",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "typedoc-vitepress-theme": "1.1.3",
    "typescript": "6.0.3",
    "use-resize-observer": "10.0.0",
    "vitepress": "2.0.0-alpha.19",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "5.0.0-rc.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx @biomejs/biome check --staged || npx @biomejs/biome check --staged 2>&1 | grep -q 'No files were processed'"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "biome check ./src ./tests ./bench",
    "format": "biome check --write ./src ./tests ./bench",
    "typecheck": "tsc --noEmit",
    "typecheck:ts7": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --project browser:chromium --project browser:firefox --project browser:webkit",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx bench/pool.ts && tsx bench/scheduler.ts && tsx bench/hook.ts && tsx bench/worker.ts && tsx bench/memory.ts",
    "publint": "publint",
    "size": "size-limit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release": "changeset publish --provenance",
    "version": "changeset version",
    "optimize-svgs": "tsx scripts/optimize-svgs.ts",
    "prepare": "simple-git-hooks"
  }
}
